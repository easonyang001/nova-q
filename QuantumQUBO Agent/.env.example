# --- Option A: remote OpenRouter (original setup, default when LLM_PROVIDER is unset) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Option B: local vLLM on 2 x L40S (see scripts/serve_vllm.sh) ---
# LLM_PROVIDER=local                      # openrouter | openai | local
# LLM_BASE_URL=http://localhost:8000/v1   # optional; overrides the provider default
# LLM_MODEL=qwen3.6-35b-a3b               # routes ALL agents to this model (vLLM --served-model-name)
# LLM_API_KEY=EMPTY                       # optional; local vLLM needs no real key
# LLM_ENABLE_THINKING=true                # local only; Qwen3.6 reasoning (default true, as in the original runs)

# CGA GPU annealer (Socket.IO server)
CGA_URI=http://<cga-server-host>:8080

# D-Wave Leap: Hybrid uses time_limit (seconds); direct QPU uses annealing_time (microseconds).
DWAVE_API_TOKEN=
DWAVE_HYBRID_SOLVER=hybrid_binary_quadratic_model_version2p

# Per-role models (optional). "provider:model" routes one role to another server or company, e.g.
#   LLM_MODEL_MODELER=openrouter:<vendor>/<model>   (needs OPENROUTER_API_KEY)
# The loop agents use agents.model in config_loop.yaml, which accepts the same form.
LLM_MODEL_CLARIFY=
LLM_MODEL_MODELER=
# Max tokens per answer (thinking + text); an answer that thinks past it is retried once without thinking
LLM_MAX_COMPLETION_TOKENS=32768
