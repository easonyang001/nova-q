\maketitle

\subsection*{0/1 Knapsack Problem}

\paragraph{Problem Statement.}
Given a set of $N$ items indexed by $i \in \{0, \dots, N-1\}$, each item $i$ has an associated weight $w_i \in \mathbb{R}_{\ge 0}$ and value $v_i \in \mathbb{R}_{\ge 0}$. A knapsack has a maximum weight capacity $W \in \mathbb{R}_{\ge 0}$. The objective is to select a subset of items to maximize the total value of the selected items, subject to the constraint that the total weight of the selected items does not exceed $W$.

\paragraph{Decision Variables.}
For each item $i \in \{0, \dots, N-1\}$, we introduce a binary decision variable $x_i \in \{0,1\}$, where $x_i = 1$ indicates that item $i$ is selected, and $x_i = 0$ otherwise. To handle the inequality constraint in a quadratic unconstrained binary optimization (QUBO) framework, we introduce $m = \lceil \log_2 W \rceil$ binary slack variables $s_j \in \{0,1\}$ for $j \in \{0, \dots, m-1\}$. These slack variables represent the unused capacity $W - \sum_{i=0}^{N-1} w_i x_i$ in binary form, such that $\sum_{j=0}^{m-1} 2^j s_j$ equals the slack.

\paragraph{QUBO Derivation.}
\textbf{Step 1.} The original problem is a maximization of total value. Converting to a minimization problem suitable for QUBO yields the objective function:
\begin{align}
  \min_{x} \quad -\sum_{i=0}^{N-1} v_i x_i.
\end{align}

\textbf{Step 2.} The weight capacity constraint is expressed as an equality by introducing the binary slack variables:
\begin{align}
  \sum_{i=0}^{N-1} w_i x_i + \sum_{j=0}^{m-1} 2^j s_j = W.
\end{align}

\textbf{Step 3.} We convert the equality constraint into a penalty term by squaring the deviation from $W$ and scaling by a penalty weight $\lambda > 0$:
\begin{align}
  P(x,s) = \lambda \left( \sum_{i=0}^{N-1} w_i x_i + \sum_{j=0}^{m-1} 2^j s_j - W \right)^2.
\end{align}
Expanding the square and applying the idempotent property $z^2 = z$ for all binary variables $z \in \{x_0, \dots, x_{N-1}, s_0, \dots, s_{m-1}\}$, we obtain:
\begin{align}
  P(x,s) &= \lambda \left[ \sum_{i=0}^{N-1} w_i^2 x_i + \sum_{j=0}^{m-1} (2^j)^2 s_j - 2W \sum_{i=0}^{N-1} w_i x_i - 2W \sum_{j=0}^{m-1} 2^j s_j \right. \nonumber \\
  &\quad \left. + 2 \sum_{0 \le i < k \le N-1} w_i w_k x_i x_k + 2 \sum_{i=0}^{N-1} \sum_{j=0}^{m-1} w_i 2^j x_i s_j + 2 \sum_{0 \le j < l \le m-1} 2^j 2^l s_j s_l + W^2 \right].
\end{align}
Collecting terms by variable type yields the general penalty contribution:
\begin{align}
  P(x,s) &= \lambda \left[ \sum_{i=0}^{N-1} (w_i^2 - 2W w_i) x_i + \sum_{j=0}^{m-1} (2^{2j} - 2W 2^j) s_j \right. \nonumber \\
  &\quad \left. + 2 \sum_{0 \le i < k \le N-1} w_i w_k x_i x_k + 2 \sum_{i=0}^{N-1} \sum_{j=0}^{m-1} w_i 2^j x_i s_j + 2 \sum_{0 \le j < l \le m-1} 2^{j+l} s_j s_l + W^2 \right].
\end{align}

\textbf{Step 4.} The complete QUBO Hamiltonian $H(x,s)$ is the sum of the negated objective and the penalty term:
\begin{align}
  H(x,s) = -\sum_{i=0}^{N-1} v_i x_i + P(x,s).
\end{align}

\textbf{Step 5.} Reading off the coefficients from $H(x,s)$, the QUBO matrix entries $Q$ and constant offset $c$ are given by:
\begin{align}
  Q_{i,i} &= -v_i + \lambda(w_i^2 - 2W w_i), & i \in \{0, \dots, N-1\}, \\
  Q_{j,j} &= \lambda(2^{2j} - 2W 2^j), & j \in \{0, \dots, m-1\}, \\
  Q_{i,k} &= 2\lambda w_i w_k, & 0 \le i < k \le N-1, \\
  Q_{i,j} &= 2\lambda w_i 2^j, & i \in \{0, \dots, N-1\}, \ j \in \{0, \dots, m-1\}, \\
  Q_{j,l} &= 2\lambda 2^{j+l}, & 0 \le j < l \le m-1, \\
  c &= \lambda W^2.
\end{align}
The QUBO is then defined as $\min_{x,s \in \{0,1\}^{N+m}} \left( \sum_{p \le q} Q_{p,q} z_p z_q + c \right)$, where $z$ denotes the concatenated vector of $x$ and $s$ variables.

\paragraph{Penalty Weight Justification.}
The penalty weight $\lambda$ must be chosen sufficiently large to ensure that any violation of the capacity constraint incurs an energy cost strictly greater than the maximum possible gain in the objective function. The maximum total value achievable by any subset of items is bounded by $\sum_{i=0}^{N-1} v_i$. Therefore, selecting $\lambda > \sum_{i=0}^{N-1} v_i$ guarantees that the penalty for any infeasible configuration dominates any potential improvement in the objective value, forcing the global minimum to reside within the feasible region.

\paragraph{Correctness Argument.}
Minimizing $H(x,s)$ over $\{0,1\}^{N+m}$ recovers the optimal solution to the original knapsack problem. For any feasible assignment, the slack variables can be chosen to exactly satisfy the equality constraint, making the penalty term $P(x,s)$ vanish. Consequently, $H(x,s)$ reduces to the negated objective, and minimizing $H$ is equivalent to maximizing the total value. For any infeasible assignment, the penalty term is strictly positive. By the choice of $\lambda$, the energy of any infeasible solution exceeds the energy of the best feasible solution. Thus, the global minimum of $H$ must correspond to a feasible configuration that maximizes the original objective.

\paragraph{Illustrative Example.}
Consider a concrete instance with $N=3$ items, weights $w_0, w_1, w_2$, values $v_0, v_1, v_2$, and capacity $W=5$. Here, $m = \lceil \log_2 5 \rceil = 2$, yielding $n = N + m = 5$ binary variables. The variables are indexed as $x_0, x_1, x_2$ (indices $0,1,2$) and $s_0, s_1$ (indices $3,4$). Substituting $W=5$ and $m=2$ into the general formulas yields the following concrete QUBO coefficients:
\begin{align}
  Q_{0,0} &= -v_0 + \lambda(w_0^2 - 10w_0), & Q_{1,1} &= -v_1 + \lambda(w_1^2 - 10w_1), & Q_{2,2} &= -v_2 + \lambda(w_2^2 - 10w_2), \\
  Q_{3,3} &= \lambda(1 - 10), & Q_{4,4} &= \lambda(4 - 20), \\
  Q_{0,1} &= 2\lambda w_0 w_1, & Q_{0,2} &= 2\lambda w_0 w_2, & Q_{1,2} &= 2\lambda w_1 w_2, \\
  Q_{0,3} &= 2\lambda w_0, & Q_{0,4} &= 4\lambda w_0, & Q_{1,3} &= 2\lambda w_1, & Q_{1,4} &= 4\lambda w_1, \\
  Q_{2,3} &= 2\lambda w_2, & Q_{2,4} &= 4\lambda w_2, & Q_{3,4} &= 4\lambda, \\
  c &= 25\lambda.
\end{align}
The resulting Hamiltonian is explicitly:
\begin{align}
  H(x,s) &= -\sum_{i=0}^{2} v_i x_i + \lambda \left( \sum_{i=0}^{2} w_i x_i + s_0 + 2s_1 - 5 \right)^2.
\end{align}
For a specific numerical instantiation, let $w = (2, 3, 4)$, $v = (3, 4, 5)$, and $\lambda = 100$. The optimal selection is $x_0=1, x_1=1, x_2=0$ (total weight $5$, total value $7$), with slack $s_0=1, s_1=0$. The minimum energy is $H^* = -7 + 100(0)^2 = -7$.

